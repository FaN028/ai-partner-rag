# ============ Python 项目通用忽略 ============

# 虚拟环境（太大，且每个人自己建）
.venv/

# Python 缓存和编译产物
__pycache__/
*.pyc

# 编辑器配置（个人本地设置，不共享）
.idea/
.vscode/

# ============ 本项目特有 ============

# 模型文件（太大，通过 download_model.py / download_reranker.py 重新下载）
models/

# 会话数据（运行生成的聊天记录）
sessions/

# Agent 工具调用轨迹（运行生成的日志，只留本地）
agent_trace.jsonl

# 服务端知识库落盘数据（运行生成，按客户端分目录）
data/

# 个人学习历史（旧版本 + 笔记，只留本地，不上传）
旧版本/
笔记/

# ============ 本地私有内容（绝不入库）============

# 环境变量文件（里面有 API Key，泄漏了要立刻作废重发）
.env
.env.local

# 测试与运行缓存
.pytest_cache/
*.log
