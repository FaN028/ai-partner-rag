# 环境变量模板：复制为 .env 并填入真实值
#
#   Windows(PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:        cp .env.example .env
#
# 使用方式（三种任选其一）：
#   1) 启动前手动设置环境变量：set DEEPSEEK_API_KEY=sk-xxxx   (Windows)
#   2) Docker 启动时注入：      docker run --env-file .env ...
#   3) 自己用 python-dotenv 之类工具加载

DEEPSEEK_API_KEY=sk-替换成你自己的key

# 向量存储后端：numpy（默认，零依赖）/ chroma（HNSW + 持久化）/ auto
RAG_VECTOR_BACKEND=chroma

# 是否启用 rerank 精排：1 开启 / 0 关闭。
# 低配机器（2G 内存）建议设 0，只做向量粗排，内存占用少一半。
RAG_RERANK=1
