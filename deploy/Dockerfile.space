# ============================================================
# Dockerfile.space —— 给「魔搭创空间 / Hugging Face Spaces」用的单服务镜像
# ============================================================
# 与根目录 Dockerfile 的区别只有三点：
#   1. 只起 Streamlit 界面（点开就能用），端口固定 7860（平台约定）
#   2. 关掉 Streamlit 的 CORS / XSRF 保护，否则平台把它嵌进 iframe 会白屏
#   3. 不做多阶段构建——平台上每次构建都要重来，单阶段更快也更好排错
#
# 本地自测：
#   docker build -f deploy/Dockerfile.space -t rag-space .
#   docker run --rm -p 7860:7860 -e DEEPSEEK_API_KEY=sk-xxx rag-space
# ============================================================
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=7860 \
    RAG_VECTOR_BACKEND=numpy

# torch 在 slim 镜像里缺 libgomp1，不装会在 import 阶段直接崩
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

# 模型在构建期下载好：运行时再下会超时，且免费实例重启后不会重下
COPY download_model.py download_reranker.py ./
RUN python download_model.py && python download_reranker.py \
    && for d in models/*/; do \
         if [ -f "$d/model.safetensors" ] && [ -f "$d/pytorch_model.bin" ]; then \
           rm -f "$d/pytorch_model.bin"; \
         fi; \
       done \
    && du -sh models

COPY . .

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/data /app/sessions \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD python -c "import sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:7860/_stcore/health', timeout=5).status == 200 else 1)"

CMD ["streamlit", "run", "app.py", \
     "--server.port=7860", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--server.enableCORS=false", \
     "--server.enableXsrfProtection=false"]
